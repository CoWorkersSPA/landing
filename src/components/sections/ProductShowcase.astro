---
// src/components/sections/ProductShowcase.astro
// "Así se ve": carrusel de capturas de lo que se instala. Cada lámina nombra el problema resuelto,
// nunca la herramienta (ni en el texto ni en la captura: logos y nombres del motor se recortan).
//
// Las capturas viven en public/img/productos/<archivo>. Una lámina sin su archivo no se publica:
// en desarrollo se ve un marcador para saber qué falta; en el build se omite, y si no queda
// ninguna, la sección completa desaparece. Una captura inventada sería una prueba falsa.
// La lámina del dominio no es captura: se dibuja con los tokens de la página (`panel`), y muestra
// nuestras propias direcciones como prueba de que usamos lo mismo que vendemos.
import { existsSync } from "node:fs";
import { join } from "node:path";

// Solo direcciones que existen hoy: si una se apaga, sale de aquí.
const domains = [
  { sub: "", label: "Tu sitio", icon: "ph-globe-simple" },
  { sub: "correo.", label: "Correo", icon: "ph-envelope-simple" },
  { sub: "nube.", label: "Archivos", icon: "ph-cloud" },
  { sub: "contabilidad.", label: "Ventas y contabilidad", icon: "ph-squares-four" },
  { sub: "acceso.", label: "Una sola clave", icon: "ph-key" },
];

type Slide = {
  icon: string;
  title: string;
  description: string;
} & ({ file: string; panel?: never } | { panel: "domains"; file?: never });

const slides: Slide[] = [
  {
    file: "correo.webp",
    icon: "ph-envelope-simple",
    title: "Correo con el nombre de tu empresa",
    description:
      "contacto@tuempresa.cl en vez de una cuenta gratuita, con tus contactos y en tu propio servidor.",
  },
  {
    panel: "domains",
    icon: "ph-globe-simple",
    title: "Todo con el nombre de tu empresa",
    description:
      "Tu sitio, tu correo, tu nube y tu sistema bajo tu propio dominio, configurado para que tus correos no caigan en spam. Así funciona el nuestro.",
  },
  {
    file: "nube.webp",
    icon: "ph-cloud",
    title: "Tus archivos, en una nube que es tuya",
    description:
      "Carpetas por área y permisos por persona. Compartes un enlace en vez de mandar el archivo por WhatsApp.",
  },
  {
    file: "acceso.webp",
    icon: "ph-key",
    title: "Una sola clave para todo",
    description:
      "Correo, nube y sistema con el mismo acceso. Si alguien deja la empresa, se le cierra todo de una vez.",
  },
  {
    file: "gestion.webp",
    icon: "ph-squares-four",
    title: "Ventas, bodega y contabilidad en un sistema",
    description:
      "Cada área tiene su espacio y todo se conecta: lo que vendes descuenta de la bodega y queda en la contabilidad. Sin planillas que no cuadran.",
  },
  {
    file: "cobranza.webp",
    icon: "ph-bell-ringing",
    title: "La cobranza que recuerda sola",
    description:
      "Tu cliente recibe el aviso antes de que venza la factura, con el monto y cómo pagar. Si se atrasa, el recordatorio sigue solo.",
  },
  {
    file: "cotizacion.webp",
    icon: "ph-file-text",
    title: "Cotizaciones con tu logo, listas para enviar",
    description:
      "Productos, precios, despacho e IVA en un documento claro, con fecha de validez. Tu cliente sabe qué paga y hasta cuándo.",
  },
];

const dir = join(process.cwd(), "public/img/productos");
const visible = slides
  .map((s) => ({ ...s, ready: s.panel ? true : existsSync(join(dir, s.file)) }))
  .filter((s) => s.ready || import.meta.env.DEV);

// Carrusel infinito: la pista lleva tres copias (antes, real, después). Las copias son solo
// imagen (aria-hidden + inert); al terminar cada transición el script salta sin animación a la
// lámina real equivalente, así nunca se llega a un borde.
const copies = [-1, 0, 1].flatMap((copy) =>
  visible.map((s, i) => ({ ...s, i, clone: copy !== 0 })),
);
---

{
  visible.length > 0 && (
    <section class="section showcase" id="asi-se-ve" aria-roledescription="carrusel">
      <span class="glow" aria-hidden="true" />
      <div class="container">
        <div class="head">
          <h2 class="section-title reveal">
            Así se ve lo que <span class="text-glow">instalamos</span>.
          </h2>
          <div class="controls reveal" data-delay="1">
            <button type="button" class="nav play" aria-label="Pausar avance automático" aria-pressed="false">
              <i class="ph ph-pause" aria-hidden="true" />
            </button>
            <button type="button" class="nav" data-dir="-1" aria-label="Anterior">
              <i class="ph ph-arrow-left" aria-hidden="true" />
            </button>
            <button type="button" class="nav" data-dir="1" aria-label="Siguiente">
              <i class="ph ph-arrow-right" aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>

      <div class="viewport reveal" data-delay="1">
      <ol class="track" tabindex="0" aria-label="Capturas de pantalla" aria-live="off">
        {copies.map((s) => (
          <li
            class="slide"
            data-real={s.i}
            aria-hidden={s.clone ? "true" : undefined}
            inert={s.clone}
            aria-roledescription={s.clone ? undefined : "lámina"}
            aria-label={s.clone ? undefined : `${s.i + 1} de ${visible.length}: ${s.title}`}
          >
            <figure>
              {s.panel === "domains" ? (
                <div class="domains">
                  <ul>
                    {domains.map((d, j) => (
                      <li style={`--j: ${j}`}>
                        <i class="ph ph-lock-simple lock" aria-hidden="true" />
                        <span class="host">
                          <span class="sub">{d.sub}</span>coworkers.cl
                        </span>
                        <span class="what">
                          <i class={`ph ${d.icon}`} aria-hidden="true" />
                          {d.label}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              ) : s.ready ? (
                <img
                  src={`/img/productos/${s.file}`}
                  width="2000"
                  height="1066"
                  alt={s.title}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              ) : (
                <div class="pending">
                  <span class="icon-tile" aria-hidden="true">
                    <i class={`ph ${s.icon}`} />
                  </span>
                  <code>public/img/productos/{s.file}</code>
                </div>
              )}
              <figcaption>
                <h3>{s.title}</h3>
                <p>{s.description}</p>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
      </div>

      <div class="progress" aria-hidden="true">
        <span class="progress-fill"></span>
      </div>

      <div class="container">
        <div class="dots" role="tablist" aria-label="Elegir captura">
          {visible.map((s, i) => (
            <button
              type="button"
              role="tab"
              aria-label={s.title}
              aria-selected={i === 0 ? "true" : "false"}
              data-index={i}
            />
          ))}
          <span class="count" aria-hidden="true">
            <span class="count-now">01</span> / {String(visible.length).padStart(2, "0")}
          </span>
        </div>
      </div>

    <dialog class="lightbox" aria-label="Vista ampliada">
      <button
        type="button"
        class="lightbox-close"
        aria-label="Cerrar vista ampliada"
      >
        <i class="ph ph-x" aria-hidden="true" />
      </button>
      <div class="lightbox-content"></div>
    </dialog>
    </section>
  )
}

<style>
  .showcase {
    overflow: hidden;
  }
  .glow {
    position: absolute;
    left: -10%;
    top: 30%;
    width: 60%;
    height: 60%;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--glow-i), transparent);
    filter: blur(40px);
  }
  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .controls {
    display: flex;
    gap: 10px;
    flex: none;
  }
  .count {
    margin-left: 12px;
    color: var(--n-500);
    font-size: 14px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .count-now {
    color: var(--n-200);
  }
  .nav {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius);
    border: 1px solid var(--n-700);
    background: transparent;
    color: var(--n-300);
    font-size: 18px;
    cursor: pointer;
    transition:
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }
  .nav:hover:not(:disabled) {
    border-color: var(--accent);
    color: var(--a-200);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* La pista arranca alineada con el contenedor y deja asomar la lámina siguiente. Se mueve con
     transform (no con scroll): así flechas, puntos y arrastre comparten un solo estado. */
  .viewport {
    margin-top: 40px;
  }
  .track {
    --inset: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    --w: min(72vw, 760px);
    --gap: 28px;
    list-style: none;
    margin: 0;
    padding: 8px var(--inset) 24px;
    display: flex;
    gap: var(--gap);
    transform: translate3d(var(--x, 0px), 0, 0);
    transition: transform 0.7s var(--ease);
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .track.dragging {
    cursor: grabbing;
    transition: none;
  }
  /* Salto invisible de una copia a la lámina real: sin ninguna transición. */
  .track.jump,
  .track.jump .slide,
  .track.jump .domains li {
    transition: none !important;
  }
  .track:focus-visible {
    outline-offset: -2px;
  }
  /* Las láminas fuera de foco se achican y se apagan; la activa queda a tamaño completo. */
  .slide {
    flex: 0 0 var(--w);
    opacity: 0.4;
    transform: scale(0.86);
    transform-origin: center 40%;
    transition:
      opacity 0.6s var(--ease),
      transform 0.7s var(--ease);
  }
  .slide.is-active {
    opacity: 1;
    transform: none;
  }
  figure {
    margin: 0;
  }
  figure img,
  .pending {
    width: 100%;
    aspect-ratio: 15 / 8;
    object-fit: cover;
    object-position: top center;
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }
  /* Lámina del dominio: una dirección por servicio, el subdominio en acento. */
  .domains {
    width: 100%;
    aspect-ratio: 15 / 8;
    display: grid;
    align-content: center;
    padding: clamp(20px, 5%, 56px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 80% at 100% 0%, var(--glow-a), transparent 70%),
      var(--surface);
    box-shadow: var(--shadow-lg);
  }
  .domains ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .domains li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 14px;
    padding: clamp(8px, 1.6vw, 15px) 0;
    border-bottom: 1px solid var(--divider);
    font-size: clamp(14px, 1.9vw, 22px);
  }
  .domains li:last-child {
    border-bottom: 0;
  }
  .lock {
    color: var(--n-500);
    font-size: 0.85em;
  }
  .host {
    color: var(--n-300);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .sub {
    color: var(--a-300);
  }
  .domains .what {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--n-500);
    font-size: 0.68em;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* Fuera de foco las direcciones siguen a la vista, solo más tenues; al entrar se encienden en cascada. */
    .domains li {
      opacity: 0.55;
      transform: translateX(-8px);
      transition:
        opacity 0.6s var(--ease),
        transform 0.6s var(--ease);
      transition-delay: calc(var(--j) * 90ms);
    }
    .slide.is-active .domains li {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 767px) {
    .domains .what {
      display: none;
    }
  }

  .pending {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 16px;
    color: var(--n-500);
    border: 1px dashed var(--n-700);
    font-size: 13px;
  }
  figcaption {
    margin-top: 22px;
    max-width: 56ch;
  }
  figcaption h3 {
    font-size: 22px;
    margin-bottom: 8px;
  }
  figcaption p {
    color: var(--n-400);
  }

  .dots {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
  .dots button {
    position: relative;
    width: 28px;
    height: 4px;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: var(--n-800);
    cursor: pointer;
    transition:
      background-color 0.4s var(--ease),
      width 0.4s var(--ease);
  }
  /* Área de toque ampliada sin engordar la barra. */
  .dots button::before {
    content: "";
    position: absolute;
    inset: -12px -2px;
  }
  .dots button[aria-selected="true"] {
    width: 48px;
    background: var(--accent);
  }

  @media (max-width: 767px) {
    .nav[data-dir] {
      display: none;
    }
    .track {
      --w: 86vw;
      --gap: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track,
    .slide,
    .dots button {
      transition: none;
    }
  }

  .progress {
    width: min(100% - 2 * var(--gutter), 760px);
    height: 3px;
    margin: 0 auto;
    overflow: hidden;
    border-radius: 3px;
    background: var(--n-800);
  }
  
  .progress-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 5s linear;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .progress-fill {
      transition: none;
    }
  }

.lightbox {
  position: fixed;
  inset: 0;
  width: 100%;
  max-width: none;
  height: 100%;
  max-height: none;
  margin: 0;
  padding: clamp(20px, 5vw, 64px);
  border: 0;
  background: transparent;
  color: var(--n-100);
  overflow: auto;
}

.lightbox[open] {
  display: grid;
  place-items: center;
}

.lightbox::backdrop {
  background: rgb(0 0 0 / 82%);
  backdrop-filter: blur(8px);
}

.lightbox-content {
  width: 100%;
  max-width: 1400px;
  margin: auto;
}

.lightbox-content figure {
  width: 100%;
}

.lightbox-content img,
.lightbox-content .domains {
  width: 100%;
  max-height: 78vh;
  aspect-ratio: auto;
  object-fit: contain;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-lg);
}

.lightbox-content img {
  display: block;
  height: auto;
  margin-inline: auto;
}

/* El clon no cuelga de .slide.is-active: sin esto las direcciones quedarían tenues y desplazadas. */
.lightbox-content .domains li {
  opacity: 1;
  transform: none;
  transition: none;
}

.lightbox-content figcaption {
  max-width: 70ch;
  margin: 24px auto 0;
}

.lightbox-content figcaption h3 {
  font-size: clamp(20px, 3vw, 28px);
}

.lightbox-content figcaption p {
  font-size: 16px;
}

.lightbox-close {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 1;
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border: 1px solid var(--n-700);
  border-radius: 50%;
  background: var(--surface);
  color: var(--n-100);
  font-size: 20px;
  cursor: pointer;
}

.lightbox-close:hover {
  border-color: var(--accent);
  color: var(--a-200);
}

.slide:not([inert]) {
  cursor: zoom-in;
}

.lightbox[open] {
  cursor: zoom-out;
}

@media (max-width: 767px) {
  .lightbox {
    padding: 64px 16px 24px;
  }

  .lightbox-content img,
  .lightbox-content .domains {
    max-height: 65vh;
  }
}
</style>


<script>
  const root = document.querySelector<HTMLElement>("#asi-se-ve");

  if (root) {
    const track = root.querySelector<HTMLElement>(".track")!;
    const slides = [...track.querySelectorAll<HTMLElement>(".slide")];
    const dots = [...root.querySelectorAll<HTMLButtonElement>(".dots button")];
    const playBtn = root.querySelector<HTMLButtonElement>(".play")!;
    const progressFill = root.querySelector<HTMLElement>(".progress-fill")!;
    const lightbox = root.querySelector<HTMLDialogElement>(".lightbox")!;
    const lightboxContent =
      lightbox.querySelector<HTMLElement>(".lightbox-content")!;
    const lightboxClose =
      lightbox.querySelector<HTMLButtonElement>(".lightbox-close")!;

    const n = dots.length;
    const DELAY = 5000;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let pos = n;
    let step = 0;
    let startX = 0;
    let dx = 0;
    let dragging = false;
    let visible = false;
    let paused = false;
    let lightboxOpen = false;
    let timer = 0;
    let clickBlocked = false;
    let hovering = false;
    const countNow = root.querySelector<HTMLElement>(".count-now");

    // Quien pide menos movimiento no recibe avance automático.
    const canRun = () =>
      !reduce &&
      !paused &&
      !lightboxOpen &&
      !dragging &&
      !hovering &&
      visible &&
      !document.hidden;

    const measure = () => {
      if (slides.length < 2) return;
      step = slides[1].offsetLeft - slides[0].offsetLeft;
    };

    const offset = (extra = 0) => {
      track.style.setProperty("--x", `${-pos * step + extra}px`);
    };

    const paint = () => {
      const real = ((pos % n) + n) % n;

      slides.forEach((slide, j) => {
        slide.classList.toggle("is-active", j === pos);
      });

      dots.forEach((dot, j) => {
        dot.setAttribute("aria-selected", String(j === real));
      });

      if (countNow) countNow.textContent = String(real + 1).padStart(2, "0");
    };

    // Salta de las copias auxiliares a la copia central sin animación.
    const normalize = () => {
      if (pos >= n && pos < 2 * n) return;

      pos = ((pos % n) + n) % n + n;

      track.classList.add("jump");
      offset();
      paint();

      void track.offsetWidth;
      track.classList.remove("jump");
    };

    // Gestiona el avance automático y la barra de progreso.
    const schedule = () => {
      window.clearTimeout(timer);

      progressFill.style.transition = "none";
      progressFill.style.transform = "scaleX(0)";

      if (!canRun()) return;

      void progressFill.offsetWidth;
      progressFill.style.transition = "";

      requestAnimationFrame(() => {
        if (canRun()) progressFill.style.transform = "scaleX(1)";
      });

      timer = window.setTimeout(() => go(pos + 1), DELAY);
    };

    const go = (target: number) => {
      if (n === 0) return;

      normalize();
      pos = target;
      offset();
      paint();

      if (reduce) normalize();

      schedule();
    };

    // Ampliación de la lámina activa.
    const openLightbox = (slide: HTMLElement) => {
      if (lightboxOpen || slide.hasAttribute("inert")) return;

      const figure = slide.querySelector("figure");
      if (!figure) return;

      lightboxContent.replaceChildren(figure.cloneNode(true));

      const image = lightboxContent.querySelector("img");
      if (image) {
        image.removeAttribute("loading");
        image.removeAttribute("width");
        image.removeAttribute("height");
      }

      lightboxOpen = true;
      window.clearTimeout(timer);

      progressFill.style.transition = "none";
      progressFill.style.transform = "scaleX(0)";

      lightbox.showModal();
      lightboxClose.focus();
    };

    const closeLightbox = () => {
      if (!lightboxOpen) return;

      lightboxOpen = false;
      lightbox.close();
      lightboxContent.replaceChildren();
      track.focus({ preventScroll: true });

      // Respeta la pausa manual del usuario.
      schedule();
    };

    // Pausa mientras el puntero (fino) está sobre el carrusel o el foco está dentro.
    const viewport = root.querySelector<HTMLElement>(".viewport")!;
    viewport.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      hovering = true;
      schedule();
    });
    viewport.addEventListener("pointerleave", () => {
      if (!hovering) return;
      hovering = false;
      schedule();
    });

    // Botón de pausa/reanudación.
    playBtn.addEventListener("click", () => {
      paused = !paused;

      playBtn.setAttribute("aria-pressed", String(paused));
      playBtn.setAttribute(
        "aria-label",
        paused
          ? "Reanudar avance automático"
          : "Pausar avance automático",
      );

      playBtn.querySelector("i")!.className =
        `ph ${paused ? "ph-play" : "ph-pause"}`;

      track.setAttribute("aria-live", paused ? "polite" : "off");

      schedule();
    });

    // Solo avanza mientras la sección está visible y la pestaña activa.
    document.addEventListener("visibilitychange", schedule);

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        schedule();
      },
      { threshold: 0.4 },
    );

    observer.observe(root);

    // Normaliza el carrusel al acabar la transición.
    track.addEventListener("transitionend", (event) => {
      if (
        event.target === track &&
        event.propertyName === "transform"
      ) {
        normalize();
      }
    });

    // Flechas de navegación.
    root
      .querySelectorAll<HTMLButtonElement>(".nav[data-dir]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          go(pos + Number(button.dataset.dir));
        });
      });

    // Indicadores inferiores.
    dots.forEach((dot, i) => {
      dot.addEventListener("click", () => go(n + i));
    });

    // Navegación por teclado.
    track.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        if (slides[pos]) openLightbox(slides[pos]);
        return;
      }

      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") {
        return;
      }

      event.preventDefault();

      go(pos + (event.key === "ArrowRight" ? 1 : -1));
    });

    // Arrastre con ratón o pantalla táctil.
    // El arrastre empieza al superar 5 px: un clic simple no captura el puntero (si no, el
    // click llegaría a la pista y no a la lámina) ni reinicia el avance automático.
    let pressed = false;
    let pointerId = 0;

    track.addEventListener("pointerdown", (event) => {
      if (event.button !== 0 || lightboxOpen) return;

      pressed = true;
      pointerId = event.pointerId;
      startX = event.clientX;
      dx = 0;
      clickBlocked = false;
    });

    track.addEventListener("pointermove", (event) => {
      if (!pressed) return;

      dx = event.clientX - startX;

      if (!dragging) {
        if (Math.abs(dx) <= 5) return;

        normalize();
        dragging = true;
        clickBlocked = true;
        track.setPointerCapture(pointerId);
        track.classList.add("dragging");
        schedule();
      }

      offset(dx);
    });

    const release = () => {
      pressed = false;
      if (!dragging) return;

      const distance = dx;
      const moved = Math.abs(distance) > Math.min(80, step * 0.15);

      dragging = false;
      track.classList.remove("dragging");

      if (moved) {
        go(
          pos -
            Math.sign(distance) *
              Math.max(1, Math.round(Math.abs(distance) / step)),
        );
      } else {
        offset();
        schedule();
      }

      dx = 0;
    };

    track.addEventListener("pointerup", release);
    track.addEventListener("pointercancel", release);

    // Impide que el final de un arrastre abra accidentalmente una lámina.
    track.addEventListener(
      "click",
      (event) => {
        if (clickBlocked) {
          event.preventDefault();
          event.stopPropagation();
          clickBlocked = false;
        }
      },
      true,
    );

    // Ampliar únicamente la lámina activa, nunca sus copias auxiliares.
    slides.forEach((slide, j) => {
      slide.addEventListener("click", () => {
        if (clickBlocked || dragging || slide.hasAttribute("inert")) {
          return;
        }

        // Una lámina vecina no se amplía: primero se trae al frente.
        if (j !== pos) {
          go(j);
          return;
        }

        openLightbox(slide);
      });
    });

    // Cierre mediante botón, clic en el fondo o Escape.
    lightboxClose.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });

    lightbox.addEventListener("cancel", () => {
      closeLightbox();
    });

    lightbox.addEventListener("close", () => {
      if (lightboxOpen) {
        lightboxOpen = false;
        lightboxContent.replaceChildren();
        schedule();
      }
    });

    // Recalcula las dimensiones cuando cambia el viewport.
    const resizeObserver = new ResizeObserver(() => {
      measure();

      track.classList.add("jump");
      offset();

      void track.offsetWidth;
      track.classList.remove("jump");
    });

    resizeObserver.observe(track);

    // Inicialización.
    measure();
    track.classList.add("jump");
    offset();
    paint();

    void track.offsetWidth;
    track.classList.remove("jump");
  }
</script>
