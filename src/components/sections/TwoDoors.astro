
---
import Button from "@components/ui/Button.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";
import { mailto } from "../../config";

const services = [
  {
    icon: "ph-code",
    title: "Software que se adapta a tu trabajo",
    description:
      "Un portal para tus clientes, una pantalla interna o un sitio que hace algo más que mostrar información. Construimos lo que tu negocio necesita cuando una solución estándar no basta.",
    tags: ["Software a medida", "Portales", "Sitios web"],
  },
  {
    icon: "ph-arrows-clockwise",
    title: "Automatización de procesos",
    description:
      "Cobranza que recuerda sola, citas que se confirman, reportes que se preparan y documentos que se procesan sin transcribirlos a mano. Menos tareas repetitivas, más tiempo para trabajar.",
    tags: ["Cobranza", "Citas", "Reportes", "Documentos"],
  },
  {
    icon: "ph-plugs-connected",
    title: "Integraciones que conectan tus sistemas",
    description:
      "Conectamos las herramientas que ya utilizas para que compartan información y trabajen juntas. Menos datos duplicados, menos pasos manuales y procesos que fluyen de principio a fin.",
    tags: ["Integraciones", "Sincronización", "Flujos de trabajo"],
  },
];

// Mientras la página de Central no esté disponible,
// el botón permite solicitar información por correo.
const CENTRAL_HREF = mailto("Quiero saber más de Central by Coworkers");
---

<section class="section" id="servicios">
  <div class="container">
    <Eyebrow text="Dos puertas, una empresa" class="reveal" />

    <h2 class="section-title reveal">
      Una base que funciona. Soluciones que se adaptan.
    </h2>

    <p class="section-intro reveal">
      Central reúne las herramientas que tu empresa necesita para trabajar
      conectada. Y cuando necesitas algo más, en Coworkers construimos lo que
      falta.
    </p>

    <div class="doors">
      <aside class="central reveal" id="central" data-spotlight>
        <!--
          Imagen provisional. Mantener la ruta actual hasta disponer
          de una fotografía propia alineada con la identidad de Central.
        -->
        <img
          src="/img/meson-mostrador.jpg"
          width="1000"
          height="1200"
          alt=""
          loading="lazy"
        />

        <p class="kicker">Central by Coworkers</p>

        <h3>
          Tu trabajo, <em>conectado.</em>
        </h3>

        <p>
          Correo con el nombre de tu empresa, archivos y documentos en la
          nube, herramientas de gestión y una sola identidad para acceder.
          Servicios que funcionan por separado, pero están pensados para
          trabajar juntos.
        </p>

        <p>
          Empieza con lo que necesitas hoy y amplía las capacidades a medida
          que tu negocio crece. Y si necesitas algo específico, podemos
          construirlo e integrarlo.
        </p>

        <Button href={CENTRAL_HREF} icon="ph-arrow-right">
          Conocer Central
        </Button>
      </aside>

      <div class="services">
        <div class="services-intro reveal">
          <p class="services-kicker">Desarrollo e integración</p>
          <h3>Lo que tu negocio necesita y ningún sistema resuelve por sí solo.</h3>
          <p>
            No tienes que cambiar tu manera de trabajar para encajar en un
            sistema. Analizamos tus procesos y construimos soluciones que
            responden a tus necesidades, conectadas con las herramientas que
            ya utilizas cuando tiene sentido.
          </p>
        </div>

        {services.map((service, i) => (
          <article class="service reveal" data-delay={i}>
            <span class="icon-tile" aria-hidden="true">
              <i class={`ph ${service.icon}`}></i>
            </span>

            <div>
              <h4>{service.title}</h4>
              <p>{service.description}</p>

              <div class="what">
                {service.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  h2.section-title {
    max-width: 30ch;
  }

  .section-intro {
    max-width: 62ch;
    color: var(--n-400);
    margin-top: 16px;
  }

  .doors {
    display: grid;
    grid-template-columns: 6fr 6fr;
    gap: 48px;
    margin-top: 48px;
    align-items: stretch;
  }

  .services {
    display: flex;
    flex-direction: column;
  }

  .services-intro {
    padding: 0 0 24px;
  }

  .services-kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--coral-300);
    margin-bottom: 12px;
  }

  .services-intro h3 {
    font-size: 25px;
    line-height: 1.2;
    max-width: 28ch;
    margin-bottom: 12px;
  }

  .services-intro > p:last-child {
    color: var(--n-400);
    max-width: 54ch;
  }

  /* Filas de servicios */

  .service {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 24px;
    align-items: start;
    padding: 30px 20px;
    margin-inline: -20px;
    border-top: 1px solid var(--divider);
    border-radius: var(--radius-lg);
    transition:
      background-color 0.4s var(--ease),
      transform 0.4s var(--ease);
  }

  .service:last-child {
    border-bottom: 1px solid var(--divider);
  }

  .service::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      70% 100% at 0% 50%,
      color-mix(in srgb, var(--accent) 10%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .service:hover {
    background: color-mix(in srgb, var(--surface) 50%, transparent);
    transform: translateX(4px);
  }

  .service:hover::before {
    opacity: 1;
  }

  .service:hover .icon-tile {
    transform: translateY(-2px);
    color: var(--a-200);
    box-shadow: var(--shadow-glow);
  }

  .service .icon-tile {
    margin-top: 2px;
    transition:
      transform 0.4s var(--ease),
      color 0.4s var(--ease),
      box-shadow 0.4s var(--ease);
  }

  .service h4 {
    font-size: 20px;
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .service p {
    color: var(--n-400);
    max-width: 54ch;
  }

  .what {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    margin-top: 16px;
    font-size: 13px;
  }

  .what span {
    padding: 4px 10px;
    border-radius: 6px;
    color: var(--n-400);
    background: color-mix(in srgb, var(--n-500) 9%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--n-500) 16%, transparent);
    transition:
      color 0.3s var(--ease),
      background-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .service:hover .what span {
    color: var(--a-300);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    box-shadow: inset 0 0 0 1px
      color-mix(in srgb, var(--accent) 30%, transparent);
  }

  /* Tarjeta de Central */

  .central {
    --mx: 50%;
    --my: 50%;

    position: relative;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-lg);
    background: var(--a-900);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 520px;
    padding: 32px;
    transition:
      transform 0.6s var(--ease),
      box-shadow 0.6s var(--ease);
  }

  .central img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
    transition:
      transform 1.2s var(--ease),
      opacity 0.6s var(--ease);
  }

  .central:hover img {
    transform: scale(1.04);
    opacity: 0.7;
  }

  .central:hover {
    transform: translateY(-4px);
    box-shadow:
      0 30px 70px -28px var(--shadow-tint),
      0 0 0 1px color-mix(in srgb, var(--coral) 32%, transparent);
  }

  /* Foco de luz bajo el cursor */

  .central::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      360px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--coral) 10%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  .central:hover::before {
    opacity: 1;
  }

  .central::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--a-900) 5%, transparent) 15%,
        var(--a-900) 78%
      ),
      radial-gradient(
        70% 50% at 100% 0%,
        color-mix(in srgb, var(--coral) 12%, transparent),
        transparent 70%
      );
  }

  /* Borde luminoso que sigue al cursor */

  .central :global(.edge) {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
    padding: 1px;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--coral-300) 70%, transparent),
      color-mix(in srgb, var(--coral) 22%, transparent) 40%,
      transparent 70%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s var(--ease);
  }

  .central:hover :global(.edge) {
    opacity: 1;
  }

  .central > :global(:not(img):not(.edge)) {
    position: relative;
    z-index: 1;
  }

  .kicker {
    font-size: 14px;
    color: var(--coral-300);
    margin-bottom: 10px;
  }

  .central h3 {
    font-size: 32px;
    line-height: 1.1;
  }

  .central h3 em {
    font-style: italic;
    color: var(--coral-300);
  }

  .central p:not(.kicker) {
    color: var(--a-200);
    margin-top: 12px;
    max-width: 40ch;
  }

  .central :global(.btn) {
    margin-top: 24px;
    align-self: flex-start;
    border-color: transparent;
    color: var(--coral-200);
    background: color-mix(in srgb, var(--coral) 14%, transparent);
  }

  .central :global(.btn:hover) {
    color: var(--coral-200);
    border-color: transparent;
    background: color-mix(in srgb, var(--coral) 24%, transparent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--coral) 8%, transparent);
  }

  .central :global(.btn:active) {
    background: color-mix(in srgb, var(--coral) 32%, transparent);
  }

  @media (max-width: 1023px) {
    .doors {
      grid-template-columns: 1fr;
    }

    .central {
      min-height: 420px;
    }

    .service {
      padding-inline: 16px;
      margin-inline: -16px;
    }
  }

  @media (hover: none) {
    .service:hover {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service,
    .service::before,
    .service .icon-tile,
    .what span,
    .central,
    .central img,
    .central::before,
    .central :global(.edge) {
      transition: none;
    }

    .service:hover,
    .central:hover {
      transform: none;
    }

    .central:hover img {
      transform: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  document
    .querySelectorAll<HTMLElement>("[data-spotlight]")
    .forEach((card) => {
      const edge = document.createElement("span");
      edge.className = "edge";
      edge.setAttribute("aria-hidden", "true");
      card.appendChild(edge);

      if (reduceMotion) return;

      card.addEventListener("pointermove", (event) => {
        const rect = card.getBoundingClientRect();

        card.style.setProperty("--mx", `${event.clientX - rect.left}px`);
        card.style.setProperty("--my", `${event.clientY - rect.top}px`);
      });
    });
</script>