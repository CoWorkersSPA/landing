---
import "@styles/global.css";
import Intro from "@components/ui/Intro.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  ogSiteName?: string;
}

const {
  title = "Coworkers.cl · Software que se entiende",
  description =
    "Software, automatizaciones e integraciones para pymes. En Coworkers construimos soluciones para resolver problemas concretos del negocio, con tecnología que se entiende y se adapta a tu forma de trabajar.",
  noindex = false,
  ogImage: ogImagePath = "/og-image.png",
  ogSiteName = "Coworkers.cl",
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(ogImagePath, siteUrl);

// Organización principal: Coworkers.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://coworkers.cl/#organization",
  name: "Coworkers.cl",
  legalName: "Coworkers SpA",
  url: "https://coworkers.cl",
  logo: "https://coworkers.cl/favicon-512.png",
  slogan: "Software que se entiende.",
  description:
    "Empresa de software en Concepción, Chile. Desarrolla software a medida, automatizaciones e integraciones para resolver necesidades concretas de las pymes.",
  email: "hola@coworkers.cl",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Concepción",
    addressRegion: "Región del Biobío",
    addressCountry: "CL",
  },
  areaServed: [
    "Concepción",
    "Talcahuano",
    "San Pedro de la Paz",
    "Chiguayante",
    "Hualpén",
    "Chile",
  ],
  knowsLanguage: "es-CL",
  brand: [
    {
      "@type": "Brand",
      name: "Coworkers.cl",
      slogan: "Software que se entiende.",
    },
    {
      "@type": "Brand",
      name: "Central by Coworkers",
      slogan: "Tu negocio, a la mano.",
    },
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Desarrollo de software a medida",
        description:
          "Portales de clientes, módulos de gestión y sitios web con funcionalidades propias.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Automatización de procesos",
        description:
          "Automatización de tareas administrativas, reportes, comunicaciones y procesamiento de documentos.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Integración de sistemas",
        description:
          "Conexión de herramientas y sistemas para reducir tareas manuales y duplicación de datos.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Central Datos",
        description:
          "Solución orientada a la gestión de datos personales y el apoyo al cumplimiento de la Ley 21.719.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Central Cobros",
        description:
          "Solución para apoyar la gestión de cobranza mediante comunicaciones por WhatsApp y correo electrónico.",
      },
    },
  ],
};
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#161826" />
    <link rel="icon" type="image/svg+xml" href="/logo-cx-negro.svg" />
    <link rel="apple-touch-icon" href="/logo-cx-negro.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-snippet:-1, max-image-preview:large"
      }
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Coworkers.cl" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="coworkers.cl: Software que se entiende. Para pymes de Concepción."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Resumen para asistentes de IA"
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    ></script>
    {/* Tema y apertura se deciden antes del primer pintado: el tema para que no haya destello
		     y la apertura para que el telón exista desde el primer frame. */}
    <script is:inline>
      try {
        var saved = localStorage.getItem("cw-theme");
        var light = saved
          ? saved === "light"
          : matchMedia("(prefers-color-scheme: light)").matches;
        document.documentElement.setAttribute(
          "data-theme",
          light ? "light" : "dark",
        );
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
    <script is:inline>
      try {
        if (
          !sessionStorage.getItem("cw-intro") &&
          !matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
          document.documentElement.setAttribute("data-intro", "");
        }
      } catch (e) {}
    </script>
    {/* Tipografía de marca: Magnetik. Hospedar los archivos en public/fonts/ y declarar
         @font-face (con font-display: swap) en global.css antes de que se use --font. */}
    {/* Íconos: Phosphor (el set que fija Nocturne). */}
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css"
    />
  </head>

  <body>
    <Intro />
    <div class="pointer-glow" aria-hidden="true"></div>
    <slot />
    <script>
      // Luz que sigue al puntero: dos variables en :root, actualizadas como máximo una vez por frame.
      if (
        matchMedia("(hover: hover)").matches &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        let raf = 0,
          px = 0,
          py = 0;
        const root = document.documentElement;
        window.addEventListener(
          "pointermove",
          (e) => {
            px = e.clientX;
            py = e.clientY;
            if (raf) return;
            raf = requestAnimationFrame(() => {
              root.style.setProperty("--cx", `${px}px`);
              root.style.setProperty("--cy", `${py}px`);
              raf = 0;
            });
          },
          { passive: true },
        );
      }

      // Scroll-reveal con IntersectionObserver (nunca listeners de scroll).
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const els = document.querySelectorAll<HTMLElement>(".reveal:not(.in)");
      if (reduce || !("IntersectionObserver" in window)) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
